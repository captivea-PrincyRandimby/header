<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add a "Logos per language" tab to Settings > Websites form -->
    <record id="view_website_form_logo_lang" model="ir.ui.view">
        <field name="name">website.form.logo.lang</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Logos per language" name="logo_lang">
                    <button name="action_generate_lang_logos" type="object"
                            class="btn-secondary mb-2"
                            string="Generate rows for active languages"/>
                    <button name="action_reset_lang_logos" type="object"
                            class="btn-secondary mb-2 ms-2"
                            string="Reset all to default logo"
                            confirm="This overwrites every language logo with the default brand logo. Continue?"/>
                    <field name="logo_lang_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="lang_id" options="{'no_create': True}"
                                   domain="[('id', 'in', parent.language_ids)]"/>
                            <field name="logo" widget="image" filename="logo_filename"
                                   options="{'accepted_file_extensions': 'image/*'}"/>
                            <field name="logo_filename" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
