<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Snippet wrapper (mirrors website_blog.s_blog_posts) -->
    <template id="s_customer_references" name="Customer References">
        <t t-call="website.s_dynamic_snippet_template">
            <t t-set="snippet_name" t-value="'s_customer_references'"/>
            <t t-set="main_page_url" t-value="'/customers'"/>
            <t t-set="snippet_classes" t-value="'s_customer_references %s' % snippet_extra_classes"/>
            <t t-set="custom_template_data" t-valuef='{"references_tags_active": true}'/>
            <t t-out="0"/>
        </t>
    </template>

    <!-- Record render template. The 'res_partner' token in the id is required
         by website.snippet.filter._render / model-template matching.
         Outputs ONE top-level card per record (no outer .row / .col): the JS grid
         (website.s_dynamic_snippet.grid) wraps each fragment in a column, using the
         columnClasses forced in customer_references.js. -->
    <template id="dynamic_filter_template_res_partner_card" name="Customer References - Cards">
        <t t-foreach="records" t-as="data">
            <t t-set="record" t-value="data['_record']"/>
            <a t-att-href="record.website_url or '#'"
               class="s_customer_reference_card card h-100 w-100 text-decoration-none">
                <div class="card-body text-center">
                    <img t-if="record.avatar_128"
                         t-attf-src="/web/image/res.partner/#{record.id}/avatar_128"
                         class="s_customer_reference_logo img-fluid mb-3"
                         t-att-alt="record.display_name"/>
                    <div t-if="references_tags_active and record.website_tag_ids"
                         class="d-flex flex-wrap justify-content-center gap-1 mt-2">
                        <span t-foreach="record.website_tag_ids" t-as="tag" t-key="tag.id"
                              class="badge rounded-pill text-bg-light border"
                              t-out="tag.name"/>
                    </div>
                </div>
                <div class="card-footer text-center border-0 bg-transparent">
                    <p class="card-title h6 mb-0" t-out="record.display_name"/>
                </div>
            </a>
        </t>
    </template>

    <!-- Register the snippet in the builder panel, in a dedicated Captivea group -->
    <template id="captivea_customer_references_snippet" inherit_id="website.snippets"
              name="Captivea: Customer References snippet">
        <xpath expr="//snippets[@id='snippet_groups']/t[@snippet-group='custom']" position="before">
            <t snippet-group="captivea_dynamic" t-snippet="website.s_snippet_group"
               string="Captivea — Dynamic"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_features_grid.svg"/>
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="cap_web_captivea_theme.s_customer_references" group="captivea_dynamic"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_references.svg"/>
        </xpath>
    </template>

</odoo>
