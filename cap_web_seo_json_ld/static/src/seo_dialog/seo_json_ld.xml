<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Add a JSON-LD code field to the Optimize SEO dialog, after Broken Links. -->
    <t t-inherit="website.OptimizeSEODialog" t-inherit-mode="extension">
        <xpath expr="//SeoChecks" position="after">
            <section class="mt-3 o_seo_json_ld" t-if="canEditSeo">
                <h4 class="border-bottom pb-2">JSON-LD (schema.org)</h4>
                <p class="text-muted small mb-2">
                    Raw JSON-LD injected into this page's &lt;head&gt; as
                    &lt;script type="application/ld+json"&gt;. Leave empty to add nothing.
                </p>
                <textarea class="form-control font-monospace" rows="8" spellcheck="false"
                          placeholder='{&#10;  "@context": "https://schema.org",&#10;  "@type": "Organization"&#10;}'
                          t-model="jsonLd.value"/>
            </section>
        </xpath>
    </t>

</templates>
