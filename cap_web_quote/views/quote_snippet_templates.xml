<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Snippet wrapper.
         Mirrors website.s_dynamic_snippet_template EXACTLY (same holders/classes so the
         public interaction works), but with a custom title + lead and NO "See all" link. -->
    <template id="s_captivea_testimonials" name="Testimonials">
        <section data-snippet="s_captivea_testimonials"
            t-attf-class="s_captivea_testimonials #{snippet_extra_classes} s_dynamic o_dynamic_snippet_empty pt64 pb64"
            data-custom-template-data="{}"
            data-number-of-records="">
            <div class="s_dynamic_snippet_container container">
                <div class="row s_nb_column_fixed">
                    <!-- Dynamic snippet loading effect -->
                    <section class="s_dynamic_snippet_holder d-none px-4 placeholder-glow">
                        <div class="row">
                            <span class="placeholder col-3 rounded"/>
                            <span class="placeholder col-2 offset-7 rounded"/>
                            <span class="placeholder mt-3 col-6 rounded"/>
                        </div>
                        <div class="row mt-4">
                            <span class="placeholder col-12 rounded" style="height: 250px;"/>
                        </div>
                    </section>
                    <section class="justify-content-between d-flex s_dynamic_snippet_title oe_unremovable oe_unmovable flex-column flex-md-row mb-lg-0 pb-3 pb-md-0 s_col_no_resize">
                        <div>
                            <h2 class="h3">What our clients say</h2>
                            <p class="lead">Real stories from the teams we help transform every day.</p>
                        </div>
                    </section>
                    <section class="s_dynamic_snippet_content oe_unremovable oe_unmovable o_not_editable col s_col_no_resize">
                        <div class="css_non_editable_mode_hidden">
                            <div class="missing_option_warning alert alert-info fade show d-none d-print-none rounded-0">
                                Your Dynamic Snippet will be displayed here... This message is displayed because you did not provide enough options to retrieve its content.<br/>
                            </div>
                        </div>
                        <div class="dynamic_snippet_template">
                            <t t-out="0"/>
                        </div>
                    </section>
                </div>
            </div>
        </section>
    </template>

    <!-- Record render template ('quote_testimonial' token required by _render).
         IMPORTANT: this must output ONE top-level element per record (one card).
         website.s_dynamic_snippet.grid wraps each returned fragment into its own
         grid column, so NO outer .row / .col wrapper here (that caused every card
         to be crammed inside a single col-3). The column wrapper + row come from
         the JS grid via the columnClasses forced in testimonials.js. -->
    <template id="dynamic_filter_template_quote_testimonial_card" name="Testimonials - Cards">
        <t t-foreach="records" t-as="data">
            <t t-set="record" t-value="data['_record']"/>
            <div class="s_cap_tcard">
                <span class="s_cap_tcard_mark" aria-hidden="true">&#8220;</span>
                <div class="s_cap_tcard_grad">
                    <p class="s_cap_tcard_quote" t-out="record.quote"/>
                </div>
                <div class="s_cap_tcard_foot">
                    <div class="s_cap_tcard_who">
                        <strong t-out="record.author"/>
                        <div class="s_cap_tcard_sub">
                            <span t-if="record.role" t-out="record.role"/>
                            <t t-if="record.role and record.company_name"> · </t>
                            <span t-if="record.company_name" t-out="record.company_name"/>
                        </div>
                    </div>
                    <div t-if="record.tag_ids" class="s_cap_tcard_tags">
                        <span t-foreach="record.tag_ids" t-as="tag" t-key="tag.id"
                              class="badge rounded-pill" t-out="tag.name"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Register the snippet in the builder panel, in the shared "Captivea —
         Dynamic" group (defined by the theme's customer references snippet). -->
    <template id="quote_testimonials_snippet" inherit_id="website.snippets" name="Testimonials snippet">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="cap_web_quote.s_captivea_testimonials" group="captivea_dynamic"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_references.svg"/>
        </xpath>
    </template>

</odoo>
