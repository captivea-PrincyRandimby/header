<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Quote / Testimonial ===== -->
    <record id="view_quote_testimonial_list" model="ir.ui.view">
        <field name="name">quote.testimonial.list</field>
        <field name="model">quote.testimonial</field>
        <field name="arch" type="xml">
            <list string="Testimonials">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="author"/>
                <field name="role"/>
                <field name="company_name"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="website_id" groups="website.group_multi_website" optional="hide"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_quote_testimonial_form" model="ir.ui.view">
        <field name="name">quote.testimonial.form</field>
        <field name="model">quote.testimonial</field>
        <field name="arch" type="xml">
            <form string="Testimonial">
                <!-- No "Go to Website" button: testimonials are shown only through the
                     dynamic snippet and have no dedicated public page. -->
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="author"/>
                            <field name="role" placeholder="e.g. Operations Director"/>
                            <field name="company_name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="website_id" options="{'no_create': True}" groups="website.group_multi_website"/>
                            <field name="is_published"/>
                        </group>
                    </group>
                    <!-- The quote sits at sheet level, not inside a <group>: a group
                         lays its children out in two label/field columns, which squeezed
                         the textarea into a narrow strip. Directly under the sheet it
                         takes the full width. -->
                    <separator string="Quote"/>
                    <field name="quote" nolabel="1" class="w-100"
                           placeholder="The client's own words, as they will read on the website…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quote_testimonial" model="ir.actions.act_window">
        <field name="name">Testimonials</field>
        <field name="res_model">quote.testimonial</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_quote_testimonial"
              parent="website.menu_content"
              sequence="25"
              name="Testimonials"
              action="action_quote_testimonial"/>


    <!-- ===== Tags (own list: expertise, industry, country, role) ===== -->
    <record id="view_quote_tag_list" model="ir.ui.view">
        <field name="name">quote.tag.list</field>
        <field name="model">quote.tag</field>
        <field name="arch" type="xml">
            <list string="Testimonial Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_quote_tag" model="ir.actions.act_window">
        <field name="name">Testimonial Tags</field>
        <field name="res_model">quote.tag</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_quote_tag"
              parent="website.menu_website_global_configuration"
              sequence="81"
              name="Testimonial Tags"
              action="action_quote_tag"
              groups="website.group_website_designer"/>

</odoo>
